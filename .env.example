# Copy to .env for local use (`npm run dev`). On Vercel, add these under
# Project → Settings → Environment Variables instead. All are optional.

# Lets Claude turn messy captions into a clean recipe card.
ANTHROPIC_API_KEY=

# Override the Claude model used for recipe cleanup (default: claude-opus-5-5).
CLAUDE_MODEL=

# If set, the app asks for this password once (Settings) before it will read links.
APP_PASSWORD=
